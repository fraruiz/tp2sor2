## TP2 SOR II - complete exactamente dos reglas.

## TODO 1: vigilar modificaciones y cambios de atributos dentro de /srv/tp2/datos.
## Use la clave tp2_datos.
-w /srv/tp2/datos -p wa -k tp2_datos

## TODO 2: registrar la syscall execve cuando se ejecute /usr local/bin/tp2-event
## en el entorno oficial amd64. Use la clave tp2_exec.
-a always,exit -F arch=b64 -S execve -F path=/usr/local/bin/tp2-event -k tp2_exec
